[Desktop Entry]
Type=Application
Name=RFab Viewer
Comment=Fast, chromeless image and video viewer
Exec=rfab-viewer %F
Icon=rfab-viewer
Terminal=false
Categories=Graphics;Viewer;AudioVideo;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;video/mp4;video/webm;video/x-msvideo;video/x-matroska;video/quicktime;
StartupNotify=false
